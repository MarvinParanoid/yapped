# ---------------------------------------------------------------------------
# yapped. — environment
# ---------------------------------------------------------------------------

# Postgres. With docker compose this is set for you in compose.yaml.
DATABASE_URL="postgresql://yapped:yapped@localhost:5432/yapped?schema=public"

# Connection pool ceiling. Requests queue once it is reached. Leave unset for a
# real Postgres (defaults to 10); set it to 3 when using `prisma dev`, whose
# PGlite backend refuses more than a handful of concurrent connections.
# DATABASE_POOL_MAX=10

# Seed strategy. "base" (default) inserts nothing — a real archive starts empty.
# "demo" loads the fictional demo dataset. There is no runtime demo flag.
# SEED_MODE="base"

# Public origin, used for share links.
APP_URL="http://localhost:3000"

# Evidence storage. "local" writes to STORAGE_LOCAL_DIR; swap for "s3" once
# lib/storage/s3.ts is filled in — nothing else in the app needs to change.
STORAGE_DRIVER="local"
# Relative paths resolve against the server's working directory. `next dev` and
# `next start` run from the project root, but the standalone build (what the
# Docker image runs) chdirs into .next/standalone — so use an ABSOLUTE path in
# production. The Docker image already sets /app/var/uploads.
STORAGE_LOCAL_DIR="./var/uploads"

# S3-compatible storage (unused while STORAGE_DRIVER=local)
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="yapped"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""
